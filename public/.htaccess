# 1. Force HTTPS — redirect any plain http:// request to https://.
#    (This was previously handled by a cPanel-managed block that isn't part
#    of this repo's source .htaccess — folding it in here so it survives
#    every future build/upload instead of depending on cPanel re-adding it.)
#
# 2. Vue Router uses "history mode" — real-looking URLs like /death-statistics
#    that are actually handled client-side. Without this, Apache 404s on a
#    direct link or a page refresh to any route other than the homepage.
#    This rule serves the request as-is if it matches a real file or
#    directory (so real assets like /assets/app.js still work normally),
#    and otherwise falls back to index.html so Vue Router can take over.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# 3. Compression is handled at the host level, NOT here. GoDaddy's Apache
#    ignores `AddOutputFilterByType` in a per-dir .htaccess, so a mod_deflate
#    / mod_brotli block here is inert. Enable it instead via cPanel ->
#    Software -> "Optimize Website" -> "Compress all content" (already on;
#    verified ~85-90% on the JSON snapshots). If the site ever moves off
#    GoDaddy, re-add an AddOutputFilterByType block for text/* + JSON here.

# 4. Caching. /assets/* filenames are content-hashed, so cache them hard.
#    index.html is NOT hashed and points at whatever the current asset
#    hashes are; deploy.sh mirrors with --delete, so a stale cached
#    index.html references chunks that 404 -> SPA fallback serves HTML for
#    the module <script> -> blank page. "no-store" (not just "no-cache")
#    guarantees the browser never holds an old copy. The HTML is ~1 KB
#    gzipped and full-page loads are rare on an SPA, so the cost is nil.
#    /data/*.json + sitemap/feed keep stable URLs across refreshes, so
#    revalidate-every-time (cheap 304 when unchanged) is right for those.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "\.(json|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# 5. Open data API. The /data/*.json snapshots double as a public,
#    read-only REST-ish API (documented at /api). Allow cross-origin GETs
#    so researchers can pull them from a browser / notebook. Public-domain
#    CDC-derived aggregates — nothing sensitive, safe to open wide.
<IfModule mod_headers.c>
  <FilesMatch "^.*\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Accept, Content-Type"
  </FilesMatch>
</IfModule>

# 6. Security headers. This is a static SPA with no v-html/innerHTML, no
#    forms that submit anywhere, and no user-generated content, so the
#    actual exploitable surface is already small — these are still cheap
#    and close off a few classes of attack outright. Scoped to .html (i.e.
#    index.html, served for every route by the SPA fallback above) since
#    that's the only response type these are meaningful for.
#
#    frame-ancestors is intentionally NOT restricted, and this doesn't set
#    X-Frame-Options either — /embed/:slug pages are meant to be <iframe>'d
#    on other sites (see src/views/EmbedView.vue). Restricting either would
#    break that feature outright.
#
#    script-src needs 'unsafe-inline': every route injects a per-page
#    <script type="application/ld+json"> block (@unhead/vue, src/seo.js)
#    with real data baked in at request time, so neither a static hash nor
#    a nonce (no per-request server logic exists on static hosting) can
#    cover it. Verified locally against a server mimicking these exact
#    headers before deploying — a first pass without gateway.umami.is in
#    connect-src silently broke analytics (the script loads from
#    cloud.umami.is but its tracking beacon posts to a DIFFERENT host,
#    gateway.umami.is) — caught via the browser console before this ever
#    reached production, not after.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloud.umami.is https://gateway.umami.is https://data.cdc.gov https://api.worldbank.org; object-src 'none'; base-uri 'self'; form-action 'self'"
  </FilesMatch>
</IfModule>
