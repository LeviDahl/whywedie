# 1. Force HTTPS — redirect any plain http:// request to https://.
#    (This was previously handled by a cPanel-managed block that isn't part
#    of this repo's source .htaccess — folding it in here so it survives
#    every future build/upload instead of depending on cPanel re-adding it.)
#
# 2. Vue Router uses "history mode" — real-looking URLs like /death-statistics
#    that are actually handled client-side. Without this, Apache 404s on a
#    direct link or a page refresh to any route other than the homepage.
#    This rule serves the request as-is if it matches a real file or
#    directory (so real assets like /assets/app.js still work normally),
#    and otherwise falls back to index.html so Vue Router can take over.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# 3. Compression. GoDaddy Apache serves everything uncompressed by default;
#    the JSON snapshots are large (mortality_demographic.json ~6 MB) and
#    text compresses ~85-90%. Brotli when the module is present, gzip
#    (mod_deflate) otherwise.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json application/xml \
    application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json application/xml \
    application/rss+xml image/svg+xml
</IfModule>

# 4. Caching. /assets/* filenames are content-hashed, so cache them hard.
#    /data/*.json keep a stable URL across pipeline refreshes, so the browser
#    must revalidate every time (cheap 304 when unchanged) or a returning
#    visitor keeps stale data. index.html likewise must never be cached.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(json|html|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# 5. Open data API. The /data/*.json snapshots double as a public,
#    read-only REST-ish API (documented at /api). Allow cross-origin GETs
#    so researchers can pull them from a browser / notebook. Public-domain
#    CDC-derived aggregates — nothing sensitive, safe to open wide.
<IfModule mod_headers.c>
  <FilesMatch "^.*\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Accept, Content-Type"
  </FilesMatch>
</IfModule>
