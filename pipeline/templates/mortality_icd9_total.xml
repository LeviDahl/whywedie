<?xml version='1.0' encoding='utf-8'?>
<request-parameters>
<!--
  D16 = "Compressed Mortality, 1979-1998", Year ONLY = one all-cause total
  per year (Deaths / Population / Crude / Age-Adjusted Rate). Identical to
  mortality_icd9_chapter.xml except B_2 = *None*. The `icd9_total` era's
  `fixed` tags every row as the synthetic non-`#` "All causes" cause, so
  historicalDeaths.js picks it up and the Death Statistics annual chart
  extends back to 1979 (continuous with icd10_total 1999+).
  {{YEAR_LIST}} -> V_D16.V1. Cells: year, Deaths, Population, Crude Rate,
  Age-Adjusted Rate.
  Test: node --env-file=.env fetch.js --type=mortality --era=icd9_total --years=1979-1985 --out=rows.json --dump
-->
<parameter><name>accept_datause_restrictions</name><value>true</value></parameter>
<parameter><name>B_1</name><value>D16.V1</value></parameter>
<parameter><name>B_2</name><value>*None*</value></parameter>
<parameter><name>B_3</name><value>*None*</value></parameter>
<parameter><name>B_4</name><value>*None*</value></parameter>
