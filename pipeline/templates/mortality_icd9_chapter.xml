<?xml version='1.0' encoding='utf-8'?>
<request-parameters>
<!--
  D16 = "Compressed Mortality, 1979-1998" (ICD-9 era). Built straight from
  the D16 request form (help/cmf.html), every control left at its default
  except:
    B_1  = D16.V1          (Group Results By = Year)
    B_2  = D16.V2-level1   (And By      = ICD Chapter -- the coarse ~17-
                            chapter roll-up of the ICD-9 Codes finder)
    O_aar_enable = true     (add Age-Adjusted Rate; 2000 US std pop)
    O_show_totals/zeros/suppressed = false
  COARSE ON PURPOSE. Chapter grain (Neoplasms / Diseases of the circulatory
  system / External causes / ...) lines up with the ICD-10 chapter roll-ups
  with no ICD-9 -> ICD-10 comparability crosswalk. A 113-list-equivalent
  ICD-9 breakdown is a separate, larger effort (see CLAUDE.md).
  {{YEAR_LIST}} -> V_D16.V1. National: O_location=D16.V9 with V_D16.V9 blank
  (= *All*). Response cells: year, chapter (label, h= depth), Deaths,
  Population, Crude Rate, Age-Adjusted Rate -> the same 6-col contract as the
  `icd10` era, so build-snapshots picks it up as ordinary mortality rows.
  Test: node --env-file=.env fetch.js --type=mortality --era=icd9 --years=1979-1985 --out=rows.json --dump
  On a 400: paste the <message> from pipeline/mortality_icd9_chapter.raw.xml.
  If it complains about non-standard AAR / VM_D16.M6_* params, the D16 form's
  collapsed "Additional Rate Options" section has them -- add with *All*.
-->
<parameter><name>accept_datause_restrictions</name><value>true</value></parameter>
<parameter><name>B_1</name><value>D16.V1</value></parameter>
<parameter><name>B_2</name><value>D16.V2-level1</value></parameter>
<parameter><name>B_3</name><value>*None*</value></parameter>
<parameter><name>B_4</name><value>*None*</value></parameter>
<parameter><name>B_5</name><value>*None*</value></parameter>
<parameter><name>F_D16.V2</name><value>*All*</value></parameter>
<parameter><name>F_D16.V4</name><value>*All*</value></parameter>
<parameter><name>F_D16.V9</name><value>*All*</value></parameter>
<parameter><name>F_D16.V10</name><value>*All*</value></parameter>
<parameter><name>I_D16.V2</name><value>*All* (All Causes of Death)</value></parameter>
<parameter><name>I_D16.V4</name><value>*All* (All Causes of Death)</value></parameter>
<parameter><name>I_D16.V9</name><value>*All* (The United States)</value></parameter>
<parameter><name>I_D16.V10</name><value>*All* (The United States)</value></parameter>
<parameter><name>M_1</name><value>D16.M1</value></parameter>
<parameter><name>M_2</name><value>D16.M2</value></parameter>
<parameter><name>M_3</name><value>D16.M3</value></parameter>
<parameter><name>O_V2_fmode</name><value>freg</value></parameter>
<parameter><name>O_V4_fmode</name><value>freg</value></parameter>
<parameter><name>O_V9_fmode</name><value>freg</value></parameter>
<parameter><name>O_V10_fmode</name><value>freg</value></parameter>
<parameter><name>O_aar_enable</name><value>true</value></parameter>
<parameter><name>O_aar_nonstd</name><value>false</value></parameter>
<parameter><name>O_aar_pop</name><value>0000</value></parameter>
<parameter><name>O_age</name><value>D16.V5</value></parameter>
<parameter><name>O_icd</name><value>D16.V2</value></parameter>
<parameter><name>O_javascript</name><value>on</value></parameter>
<parameter><name>O_location</name><value>D16.V9</value></parameter>
<parameter><name>O_oc-sect1-request</name><value>close</value></parameter>
<parameter><name>O_precision</name><value>1</value></parameter>
<parameter><name>O_rate_per</name><value>100000</value></parameter>
<parameter><name>O_show_suppressed</name><value>false</value></parameter>
<parameter><name>O_show_totals</name><value>false</value></parameter>
<parameter><name>O_show_zeros</name><value>false</value></parameter>
<parameter><name>O_timeout</name><value>600</value></parameter>
<parameter><name>O_title</name><value>whywedie - D16 compressed mortality by year x ICD chapter, national</value></parameter>
<parameter><name>V_D16.V1</name>{{YEAR_LIST}}</parameter>
<parameter><name>V_D16.V2</name><value>*All*</value></parameter>
<parameter><name>V_D16.V4</name><value>*All*</value></parameter>
<parameter><name>V_D16.V5</name><value>*All*</value></parameter>
<parameter><name>V_D16.V6</name><value>00</value></parameter>
<parameter><name>V_D16.V7</name><value>*All*</value></parameter>
