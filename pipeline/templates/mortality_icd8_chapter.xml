<parameter><name>F_D74.V10</name><value>*All*</value></parameter>
<parameter><name>I_D74.V2</name><value>*All* (All Causes of Death)</value></parameter>
<parameter><name>I_D74.V4</name><value>*All* (All Causes of Death)</value></parameter>
<parameter><name>I_D74.V9</name><value>*All* (The United States)</value></parameter>
<parameter><name>I_D74.V10</name><value>*All* (The United States)</value></parameter>
