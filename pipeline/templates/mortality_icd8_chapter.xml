<?xml version='1.0' encoding='utf-8'?>
<request-parameters>
<!--
  D74 = "Compressed Mortality, 1968-1978" (ICD-8 era). NOT D15 -- on today's
  WONDER, D15 is the Tuberculosis (OTIS) system. Params matched to a captured
  working D74 web-UI request (Year x ICD Chapter, Age-Adjusted Rate checked);
  the ICD-8 twin of mortality_icd9_chapter.xml:
    B_1  = D74.V1          (Year)
    B_2  = D74.V2-level1   (ICD Chapter -- ~17 chapters)
    O_aar = aar_std + O_aar_enable = true   (age-adjusted; 2000 US std pop)
  COARSE ON PURPOSE -- chapter grain maps to the ICD-10 chapter roll-ups with
  no ICD-8 -> ICD-10 comparability crosswalk. D74 has no Injury-Intent section
  (unlike D16), so no V12 / V13. Location V_ fields left BLANK (CMF reads that
  as all of the US). {{YEAR_LIST}} -> V_D74.V1.
  Response cells: year, chapter (label, h= depth), Deaths, Population,
  Crude Rate, Age-Adjusted Rate -> the same 6-col contract as `icd9` / `icd10`.
  Test: node --env-file=.env fetch.js --type=mortality --era=icd8 --years=1968-1972 --out=rows.json --dump
  On a 400: paste the <message> from pipeline/mortality_icd8_chapter.raw.xml.
-->
<parameter><name>accept_datause_restrictions</name><value>true</value></parameter>
<parameter><name>B_1</name><value>D74.V1</value></parameter>
<parameter><name>B_2</name><value>D74.V2-level1</value></parameter>
<parameter><name>B_3</name><value>*None*</value></parameter>
<parameter><name>B_4</name><value>*None*</value></parameter>
<parameter><name>B_5</name><value>*None*</value></parameter>
