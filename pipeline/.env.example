# pipeline/.env  —  COPY to pipeline/.env and fill in. NEVER commit the real
# file (it's gitignored). Nothing in this repo reads secrets from source.
#
# Load it at runtime:
#   node --env-file=.env fetch.js --type=mortality --era=icd10
#
# Or provide the same keys through your host's own mechanism (a PaaS
# "secrets" panel, GitHub Actions secrets, systemd EnvironmentFile, ...) and
# drop the --env-file flag — config.js just reads process.env.

# --- cPanel MySQL, reached OVER THE NETWORK ----------------------------
# cPanel has no Node runtime, so this pipeline runs elsewhere and connects
# to the cPanel database remotely. Therefore:
#   * DB_HOST is the cPanel server's hostname (NOT "localhost"). Find it in
#     cPanel: it's often your domain, or the "Shared IP"/"Dedicated IP" under
#     "General Information", or the host shown in phpMyAdmin.
#   * cPanel > Remote MySQL must list the PUBLIC IP of the machine running
#     this pipeline (a fixed IP works; GitHub Actions' rotating IPs do not —
#     see pipeline/README.md).
#   * DB_NAME / DB_USER keep the cPanel account prefix (e.g. abc12345_whywedie).
DB_HOST=REPLACE_your-cpanel-server-hostname
DB_PORT=3306
DB_NAME=REPLACE_cpaneluser_whywedie
DB_USER=REPLACE_cpaneluser_wwdpipe
DB_PASSWORD=REPLACE_me

# TLS for the DB connection:
#   true         TLS, verify the server certificate
#   skip-verify  TLS, don't verify the certificate
#   (unset/empty) NO TLS — plaintext
# GoDaddy shared-hosting MySQL has TLS DISABLED on the wire, so `true` and
# `skip-verify` both fail with "Server does not support secure connection".
# Leave this empty for GoDaddy. The link is then plaintext over the internet
# (the CDC data is public, but the DB password is exposed in transit — use an
# SSH tunnel to 127.0.0.1 if that matters to you).
DB_SSL=

# --- Snapshot output --------------------------------------------------
# build-snapshots.js writes mortality.json / natality.json / meta.json here.
# Because the pipeline runs off the cPanel box, this is a LOCAL directory on
# the pipeline host; a separate step publishes it to public_html/data on the
# site (see pipeline/README.md "Publishing snapshots").
SNAPSHOT_OUT_DIR=./snapshots

# --- Census Bureau API (fetch-census-fertility.js only) ----------------
# Free key: https://api.census.gov/data/key_signup.html — instant by email,
# no approval wait. Used ONLY to backfill the general fertility rate's
# denominator (women aged 15-44, national) for years past WONDER's own
# coverage (2021+ — see fetch-census-fertility.js). Not a WONDER/database
# credential; not read by fetch.js or any *.xml template.
CENSUS_API_KEY=REPLACE_me

# --- Optional tuning ------------------------------------------------
# WONDER_TIMEOUT_MS=120000
# WONDER_BASE_URL=https://wonder.cdc.gov/controller/datarequest
# TEMPLATE_DIR=./templates
# DB_BATCH_SIZE=1000
# DB_CONNECT_TIMEOUT_MS=20000
