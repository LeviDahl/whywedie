# Copy to .env.deploy (gitignored) and fill in. Used by ./deploy.sh only —
# the GitHub Action reads the same values from repo Secrets instead.
# From cPanel -> FTP Accounts -> "Configure FTP Client".
FTP_HOST=whywedie.org
# ^ the bare domain — GoDaddy has no `ftp.` DNS record
FTP_USER=user@whywedie.org
FTP_PASSWORD=
# "/" if this FTP account is chrooted to public_html; else "/public_html"
FTP_REMOTE_DIR=/
